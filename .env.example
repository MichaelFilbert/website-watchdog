DATABASE_URL=postgres://watchdog:watchdog@localhost:5432/watchdog
PORT=3000
# auto | anthropic | ollama | mock.  auto = Anthropic if ANTHROPIC_API_KEY is set, else Ollama if reachable, else mock.
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Used to sign outbound webhooks (HMAC-SHA256). Change it.
WEBHOOK_SECRET=dev-secret-change-me
# Used when a monitor has no webhook URL of its own.
DEFAULT_WEBHOOK_URL=
# auto = Playwright with plain-fetch fallback | playwright | http
FETCH_MODE=auto
# Allow monitoring localhost / private addresses (off by default, SSRF guard).
ALLOW_PRIVATE_HOSTS=false
